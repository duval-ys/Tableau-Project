      <aliases enabled='yes' />
      <column caption='Sales selected year' datatype='real' name='[Calculation_1105915214512713728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1]&#13;&#10;THEN [Sales]&#13;&#10;END' />
      </column>
      <column caption='Sales change YoY' datatype='real' name='[Calculation_1105915214515408899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(Sum([Calculation_1105915214512713728])-sum([Sales selected year (copy)_1105915214513532929]))/sum([Sales selected year (copy)_1105915214513532929])' />
      </column>
      <column caption='●Sales' datatype='string' name='[Calculation_1105915214517637125]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1105915214515408899]&lt; 0&#13;&#10;THEN &quot;●&quot;&#13;&#10;ELSE &quot; &quot;&#13;&#10;END' />
      </column>
      <column caption='Selected Year' datatype='integer' name='[Calculation_1105915214518874118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Metric Swap Calc' datatype='real' name='[Calculation_1105915214703144987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sales&quot; THEN ZN (SUM([Calculation_1105915214512713728]))&#13;&#10;WHEN &quot;Orders&quot; THEN ZN(COUNT([Sales selected year (copy)_1105915214671028239]))&#13;&#10;END' />
      </column>
      <column caption='Sales btn' datatype='string' name='[Calculation_1105915215024410658]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;SALES&quot;' />
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Customer sign' datatype='real' default-format='*▲;▼' name='[Customer change YoY (copy)_1105915214676979737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD([Order selected year (copy)_1105915214675267605])-COUNTD([Order Previous year (copy)_1105915214674952212]))/COUNTD([Order Previous year (copy)_1105915214674952212])' />
      </column>
      <column caption='Metric Swap Calc py' datatype='real' name='[Metric Swap Calc (copy)_1105915214705025053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sales&quot; THEN ZN (SUM([Sales selected year (copy)_1105915214513532929]))&#13;&#10;WHEN &quot;Orders&quot; THEN ZN(COUNT([Sales Previous year (copy)_1105915214670430222]))&#13;&#10;END' />
      </column>
      <column caption='Metric Swap Calc label' datatype='string' name='[Metric Swap Calc (copy)_1105915214706909214]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sales&quot; THEN &quot;$&quot; + STR(ROUND((SUM([Calculation_1105915214512713728])/1000),1)) + &quot;K&quot;&#13;&#10;WHEN &quot;Orders&quot; THEN STR(COUNT([Sales selected year (copy)_1105915214671028239]))&#13;&#10;END' />
      </column>
      <column caption='Metric Swap Calc PY label ' datatype='string' name='[Metric Swap Calc label (copy)_1105915214711357471]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sales&quot; THEN &quot;$&quot; + STR(ROUND((SUM([Sales selected year (copy)_1105915214513532929])/1000),1)) + &quot;K&quot;&#13;&#10;WHEN &quot;Orders&quot; THEN STR(COUNT([Sales Previous year (copy)_1105915214670430222]))&#13;&#10;END' />
