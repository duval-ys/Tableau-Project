              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1]&#13;&#10;THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='Sales change YoY' datatype='real' name='[Calculation_1105915214515408899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([Calculation_1105915214512713728])-sum([Sales selected year (copy)_1105915214513532929]))/sum([Sales selected year (copy)_1105915214513532929])' />
            </column>
            <column caption='Selected Year' datatype='integer' name='[Calculation_1105915214518874118]' role='measure' type='quantitative'>
